# Docker Compose deployment. Copy to .env and fill in.

# Shared secret for the loopback service; any long random string.
RCU_INTERNAL_TOKEN=

# php artisan key:generate --show
APP_KEY=
APP_ENV=production
APP_DEBUG=false

DB_DATABASE=rcu
DB_USERNAME=rcu
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Legacy catalogue (Drupal). Leave LEGACY_DB_HOST as mysql only if you load a
# dump into the compose database; point it at the real host otherwise.
# NEVER `localhost` -- to the mysql driver that means a socket inside this
# container, which does not exist. See DEPLOY.md section 6.
LEGACY_DB_HOST=mysql
LEGACY_DB_DATABASE=rcud
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# Reach the host's MySQL over its socket instead of TCP: no restart, nothing
# exposed. Overrides LEGACY_DB_HOST when set, and the grant it needs is
# 'user'@'localhost', not the bridge subnet.
# LEGACY_DB_SOCKET=/var/run/mysqld/mysqld.sock
# LEGACY_DB_SOCKET_DIR=/var/run/mysqld

# The uid:gid the CV containers run as. Set both to whoever owns work/ on the
# host -- `id -u` and `id -g` -- or the catalog build writes fingerprints,
# overlays and the token index as root and you need a container to delete your
# own build output. Nothing in the image depends on the value.
RCU_UID=1000
RCU_GID=1000

# Catalogue photo files on the host, mounted read-only into both containers.
RCU_FILES_DIR=./files
RCU_ITEM_URL=https://pultov.net/item/{id}

RCU_WATERMARK_FILTER=1
RCU_WATERMARK_TERMS=PULTOVNET

# Bind the web port to loopback and put a reverse proxy in front for TLS.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
